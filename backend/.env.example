# ===== OpenWeatherMap =====
# Consigue una API key GRATIS en: https://openweathermap.org/api
# (Registro -> API keys). Pega tu clave aquí y renombra este archivo a ".env"
OWM_API_KEY=your_api_key_here
OWM_BASE_URL=https://api.openweathermap.org

# ===== Valores por defecto del dominio =====
DEFAULT_UNITS=metric
DEFAULT_LANG=es

# ===== Caché (segundos que se reutiliza una respuesta) =====
CACHE_TTL=600

# ===== CORS: orígenes del frontend permitidos (separados por comas) =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
